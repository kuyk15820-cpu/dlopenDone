<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- 1. Bundle ID ของแอป -->
	<key>application-identifier</key>
	<string>com.yourdomain.dylibtester</string>
	
	<!-- 2. สิทธิ์ข้าม Sandbox อ่าน/เขียนไฟล์ได้ทุกตำแหน่ง -->
	<key>platform-application</key>
	<true/>
	<key>com.apple.security.app-sandbox</key>
	<false/>
	<key>com.apple.private.security.no-sandbox</key>
	<true/>
	<key>com.apple.private.security.no-container</key>
	<true/>
	<key>com.apple.security.exception.files.absolute-path.read-write</key>
	<array>
		<string>/</string>
	</array>

	<!-- 3. สิทธิ์ Network สำหรับดาวน์โหลด ldid -->
	<key>com.apple.security.network.client</key>
	<true/>

	<!-- 4. สิทธิ์สำหรับ dlopen() โหลด .dylib เข้าแอปตัวเอง -->
	<key>com.apple.private.skip-library-validation</key>
	<true/>
	<key>dynamic-codesigning</key>
	<true/>

	<!-- 5. สิทธิ์รัน spawnRoot สลับ Persona เป็น Root เพื่อใช้ ldid -->
	<key>com.apple.private.persona-mgmt</key>
	<true/>

	<!-- 6. สิทธิ์ UI & IOKit พื้นฐาน -->
	<key>com.apple.security.exception.iokit-user-client-class</key>
	<array>
		<string>AGXDeviceUserClient</string>
		<string>IOSurfaceRootUserClient</string>
	</array>
</dict>
</plist>
